{
  "name": "@meshflow/rendergate",
  "version": "0.1.6",
  "description": "The official rendering gateway plugin for MeshFlow",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",  
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",   
        "default": "./index.js"
      }
    }
  },
  "author": "nzy",
  "peerDependencies": {
    "@meshflow/core": ">=0.5.9"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nzy19940403/meshflow.git",
    "directory": "utils/plugins/rendergate"
  },
  "bugs": {
    "url": "https://github.com/Nzy19940403/meshflow/issues"
  },

  "license": "MIT",
  "keywords": [
    "form",
    "form-engine",
    "logic-engine",
    "topology",
    "async-linkage",
    "watermark",
    "dag",
    "reactive",
    "render-gate"
  ]
}