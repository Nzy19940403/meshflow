{
  "name": "@meshflow/form",
  "version": "0.3.0",
  "description": "Form orchestration adapter for @meshflow/core, providing high-level form logic and schema validation.",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",  
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",   
        "default": "./index.js"
      }
    }
  },
  "author": "nzy",
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "form",
    "meshflow",
    "form-logic",
    "schema-validator",
    "reactive-form"
  ],
  "dependencies": {
    "@meshflow/core": "^0.8.8"
  },
  "peerDependencies": {
    "@meshflow/core": ">=0.8.8",
    "@jsonforms/core": ">=3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nzy19940403/meshflow.git",
    "directory": "utils/forms"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsup": "^8.0.0",
    "@jsonforms/core": "^3.8.0"
  }
}